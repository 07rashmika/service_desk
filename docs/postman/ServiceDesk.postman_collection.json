{
  "info": {
    "name": "ServiceDesk API v1",
    "description": "REST API for the ServiceDesk IT ticketing system.\n\n1. Pick the **ServiceDesk Local** environment.\n2. Run **Auth \u203a Get token** (it saves the token automatically).\n3. Every other request sends it as `Authorization: Bearer {{token}}`.\n\nPermissions are the same as on the website: employees only see their own tickets; IT Support and Admin see the queue.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "ticket_id",
      "value": "1"
    },
    {
      "key": "notification_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"Postman\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Swap email + password for a token. Saved to the environment's `token` variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "me"
              ]
            },
            "description": "The signed-in person, their role and permissions."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign out (revoke token)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Lookups",
      "item": [
        {
          "name": "Categories, priorities, statuses, technicians",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/lookups",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "lookups"
              ]
            },
            "description": "Use the ids when creating or filtering tickets."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "List tickets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tickets?scope=open&per_page=25",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets"
              ],
              "query": [
                {
                  "key": "scope",
                  "value": "open"
                },
                {
                  "key": "per_page",
                  "value": "25"
                }
              ]
            },
            "description": "Staff scopes: open (default), mine, unassigned, overdue, reported, all. Employees always get their own tickets. Filters: status (slug), priority (id), category (id), search."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search tickets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tickets?scope=all&search=SD-000001",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets"
              ],
              "query": [
                {
                  "key": "scope",
                  "value": "all"
                },
                {
                  "key": "search",
                  "value": "SD-000001"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Report an issue",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tickets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Laptop will not connect to the office Wi-Fi\",\n  \"description\": \"It sees the network but fails to connect since this morning. My phone connects fine.\",\n  \"category_id\": 3,\n  \"priority_id\": 3\n}"
            },
            "description": "Staff can add `requester_id` to log a ticket for an employee. To attach files, use the form-data version."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('ticket_id', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Report an issue with attachments",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tickets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Printer on floor 4 prints blank pages",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "The printer pulls paper through but the pages come out blank.",
                  "type": "text"
                },
                {
                  "key": "category_id",
                  "value": "5",
                  "type": "text"
                },
                {
                  "key": "priority_id",
                  "value": "2",
                  "type": "text"
                },
                {
                  "key": "attachments[]",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "description": "Pick a PNG/JPG/PDF/TXT/LOG file (max 5 MB, up to 5 files)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('ticket_id', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Show ticket",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
